---
/* A way in: the essays a developer, an architect or a decision maker should
 * read, in the order to read them. The same 37 essays; this page only picks
 * and orders. */
import Page from "../../layouts/Page.astro";
import { getCollection } from "astro:content";
import { PATHS } from "../../lib/parts";

export async function getStaticPaths() {
  return PATHS.map((p) => ({ params: { path: p.id }, props: { path: p } }));
}

const base = import.meta.env.BASE_URL;
const { path } = Astro.props;
const essays = await getCollection("essays");
const byNumber = new Map(essays.map((e) => [e.data.number, e]));
const picked = path.numbers.map((n) => byNumber.get(n)!);
const first = picked[0];
---
<Page
  title={`${path.who}: ${path.title} — abap2UI5 Insights`}
  description={path.lead}
  trail={[{ text: "Insights", href: base }, { text: path.who }]}
  measure="article"
>
  <article class="essay">
    <header>
      <a class="part-link" href={`${base}#ways-in`}>{path.who}</a>
      <h1>{path.title}</h1>
      <p class="standfirst">{path.lead}</p>
      <p class="reading">{picked.length} essays · about {path.minutes} minutes · <a href={`${base}${first.id}/`}>start with #{first.data.number}</a></p>
    </header>
    <ol class="essays">
      {picked.map((e) => (
        <li>
          <a href={`${base}${e.id}/`}>
            <span class="n">#{e.data.number}</span>
            <span class="t">{e.data.title}</span>
            <span class="d">{e.data.description}</span>
          </a>
        </li>
      ))}
    </ol>
    <aside class="part-end">
      <p>Each essay links its previous and next in the series, so a path is a starting point, not a fence: wherever one leads you, the rest is one click away. <a href={base}>All thirty-seven →</a></p>
    </aside>
  </article>
</Page>
