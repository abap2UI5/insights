---
/* One essay. The address is the file name without .md - /insights/06-ui5-over-
 * the-wire/ - and the number in it is the essay's place in reading order.
 *
 * The same route answers the addresses of the earlier numbering
 * (src/lib/moved.ts) with a page that names the essay's new address and
 * sends the reader there. */
import { getCollection } from "astro:content";
import { MOVED } from "../lib/moved";
import Essay from "../components/Essay.astro";
import Moved from "../components/Moved.astro";

export async function getStaticPaths() {
  const essays = (await getCollection("essays")).sort((a, b) => a.data.number - b.data.number);
  const bySlug = new Map(essays.map((e) => [e.id, e]));
  return [
    ...essays.map((entry) => ({ params: { slug: entry.id }, props: { entry, essays } })),
    ...Object.entries(MOVED).map(([old, slug]) => ({ params: { slug: old }, props: { moved: bySlug.get(slug)! } })),
  ];
}

const { entry, essays, moved } = Astro.props;
---
{moved ? <Moved entry={moved} /> : <Essay entry={entry!} essays={essays!} />}
